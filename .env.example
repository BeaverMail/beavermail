# Copy to .env (git-ignored) and fill in. Used by integration tests only.
# Default values match a local test server (Dovecot/GreenMail in Docker).
IMAP_HOST=127.0.0.1
IMAP_PORT=3143
IMAP_TLS=none        # none | starttls | tls
SMTP_HOST=127.0.0.1
SMTP_PORT=3025
SMTP_TLS=none        # none | starttls | tls
MAIL_USER=test@localhost
MAIL_PASSWORD=changeme
